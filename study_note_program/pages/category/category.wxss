/* 全局样式 */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
}
.category-container {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.header {
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.2);
  position: relative;
}
.title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
/* 批量操作栏 */
.batch-action-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 88rpx;
  background: #1f2937;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.selected-count {
  font-size: 24rpx;
  color: #fff;
}
.batch-delete-btn {
  height: 50rpx;
  line-height: 50rpx;
  padding: 0 20rpx;
  background: #ef4444;
  color: #fff;
  border-radius: 25rpx;
  font-size: 22rpx;
  border: none;
}
.batch-delete-btn::after {
  border: none;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 分类区域通用样式 */
.category-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.section-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.section-desc {
  font-size: 22rpx;
  color: #9ca3af;
}
.edit-mode-btn {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  color: #4b5563;
  border-radius: 24rpx;
  font-size: 22rpx;
  border: none;
}
.edit-mode-btn::after {
  border: none;
}
.empty-tips {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.6;
}

/* 系统分类列表 */
.system-category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.system-category-item {
  flex-shrink: 0;
}
.category-tag {
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 180rpx;
}
.tag-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #2563eb;
}
.tag-desc {
  font-size: 20rpx;
  color: #64748b;
}

/* 自定义分类列表 */
.custom-category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.custom-category-item {
  flex: 1;
  min-width: 280rpx;
  max-width: calc(50% - 10rpx);
}
.category-card {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  display: flex;
  align-items: center;
}
.category-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
/* 选择框样式 - 强化显示，确保✅能正常展示 */
.select-checkbox {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  z-index: 10; /* 提升层级，防止被遮挡 */
}
.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 6rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff; /* 增加白色背景，确保✅显示清晰 */
}
.checkbox.checked {
  border-color: #667eea;
  background: #667eea !important; /* 强制生效 */
  color: #fff !important;
}
/* 强制显示✅，提升优先级 */
.checkbox.checked::after {
  content: "✅" !important;
  font-size: 22rpx !important;
  position: static !important;
  transform: none !important;
  display: block !important;
}
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}
.card-desc {
  font-size: 20rpx;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-sort {
  font-size: 18rpx;
  color: #9ca3af;
}
/* 编辑按钮 */
.edit-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #6b7280;
}

/* 功能说明区 */
.feature-desc-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.feature-icon {
  font-size: 28rpx;
  margin-top: 2rpx;
}
.feature-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

/* 底部按钮区 */
.footer-btn-area {
  padding: 20rpx 30rpx 40rpx;
}
.add-category-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 6rpx 25rpx rgba(102, 126, 234, 0.4);
}
.add-category-btn::after {
  border: none;
}
.add-category-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

/* 表单弹窗 */
.form-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}
.modal-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-body {
  padding: 30rpx;
}
.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 24rpx;
  color: #4b5563;
}
.form-input {
  height: 70rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}
.form-textarea {
  min-height: 120rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.modal-footer {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.modal-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.cancel-btn {
  background: #f9fafb;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
}
.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}
.confirm-btn::after {
  border: none;
}

/* 删除弹窗 */
.delete-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 500rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}
.delete-content {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.delete-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
}
.delete-desc {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}
.delete-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
.delete-confirm-btn {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
  border: none;
}
.delete-confirm-btn::after {
  border: none;
}

/* 加载状态隐藏按钮文字 */
button[loading]::after {
  content: "" !important;
}