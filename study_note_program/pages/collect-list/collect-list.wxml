<view class="collect-container">
  <!-- 顶部导航栏（自定义，更美观） -->
  <view class="custom-nav-bar">
    <button class="back-icon" bindtap="goBack">
      <text class="iconfont">←</text>
    </button>
    <text class="nav-title">我的收藏</text>
    <view class="placeholder"></view> <!-- 占位，保持标题居中 -->
  </view>

  <!-- 收藏列表滚动容器 -->
  <scroll-view 
    class="list-scroll" 
    scroll-y 
    bindscrolltolower="onReachBottom"
    lower-threshold="100"
    refresher-enabled="true"
    bindrefresherrefresh="loadCollectList"
    refresher-triggered="{{loading}}">
    
    <!-- 加载中（初始/刷新） -->
    <view class="loading-container" wx:if="{{loading && collectList.length === 0}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载收藏中...</text>
    </view>

    <!-- 空数据（优雅展示） -->
    <view class="empty-container" wx:if="{{!loading && collectList.length === 0}}">
      <image class="empty-icon" src="/static/image/icons/empty.png" mode="aspectFit"></image>
      <text class="empty-text">暂无收藏笔记~</text>
      <text class="empty-tip">快去收藏你喜欢的笔记吧</text>
    </view>

    <!-- 收藏列表（卡片式设计） -->
    <view class="collect-list" wx:if="{{collectList.length > 0}}">
      <view class="collect-card" wx:for="{{collectList}}" wx:key="id">
        <!-- 笔记内容区域（点击跳转详情） -->
        <view 
          class="note-content" 
          bindtap="goToNoteDetail" 
          data-note-id="{{item.id}}"
          data-user-id="{{item.user_id}}"
          data-collect-count="{{item.collect_count}}">
          
          <!-- 作者信息栏 -->
          <view class="author-bar">
            <image class="avatar" src="{{item.avatar || app.globalData.defaultAvatarUrl}}" mode="circle"></image>
            <text class="author-name">{{item.author_nickname}}</text>
            <view class="collect-tag">
              <text class="tag-icon">收藏数★</text>
              <text class="tag-count">{{item.collect_count}}</text>
            </view>
          </view>

          <!-- 笔记核心内容 -->
          <view class="note-body">
            <text class="note-title">{{item.title}}</text>
            <text class="note-desc">
              {{item.content.length > 80 ? item.content.substring(0, 80) + '...' : item.content}}
            </text>
          </view>

          <!-- 底部信息栏 -->
          <view class="note-footer">
            <text class="collect-time">收藏于 {{item.create_time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{loading && collectList.length > 0}}">
      <view class="small-spinner"></view>
      <text class="load-more-text">加载更多...</text>
    </view>

    <!-- 到底提示 -->
    <view class="no-more" wx:if="{{!loading && !pagination.hasMore && collectList.length > 0}}">
      <text class="no-more-text">已经到底啦~</text>
    </view>
  </scroll-view>
</view>