/* 全局容器 */
.collect-container {
  width: 100%;
  height: 100vh;
  background-color: #f5f7fa;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 99;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.back-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  border: none;
  padding: 0;
  margin: 0;
}

.back-icon .iconfont {
  font-size: 28rpx;
  color: #fff;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
}

.placeholder {
  width: 60rpx;
}

/* 滚动容器 */
.list-scroll {
  height: calc(100vh - 120rpx);
  padding: 30rpx;
  box-sizing: border-box;
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空数据 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

/* 收藏列表 */
.collect-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 卡片样式 */
.collect-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.collect-card:active {
  transform: scale(0.98);
}

/* 作者信息栏 */
.author-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.author-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.collect-tag {
  display: flex;
  align-items: center;
  background: #f8f0ff;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.tag-icon {
  font-size: 20rpx;
  color: #764ba2;
  margin-right: 6rpx;
}

.tag-count {
  font-size: 24rpx;
  color: #764ba2;
  font-weight: 600;
}

/* 笔记内容 */
.note-body {
  margin-bottom: 20rpx;
}

.note-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.note-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部信息 */
.note-footer {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.collect-time {
  font-size: 24rpx;
  color: #999;
}

/* 取消收藏按钮 */
.cancel-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  background: #ff4d4f;
  color: #fff;
  border: none;
  border-radius: 20rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  line-height: 1;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.small-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 15rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 到底提示 */
.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: #ccc;
}

/* 动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}