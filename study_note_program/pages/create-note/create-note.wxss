page {
  background: #f5f7fa;
}
.create-note-container {
  width: 100%;
  min-height: 100vh;
}

/* 未登录 */
.not-login-box {
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
  min-height: 80vh;
}
.login-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08);
}
.icon-box {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.login-card .title {
  font-size: 40rpx; font-weight: bold; color: #333;
}
.login-card .desc {
  font-size: 26rpx; color: #666; margin: 20rpx 0 40rpx;
}
.go-login-btn {
  background: #409eff;
  color: #fff;
  border-radius: 50rpx;
  border: none;
  height: 80rpx;
  font-size: 28rpx;
}

/* 导航 */
.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.nav-left {
  font-size: 36rpx;
  color: #333;
}
.nav-title {
  font-size: 32rpx; font-weight: bold;
}

/* 表单 */
.form-scroll {
  padding: 20rpx;
}
.form-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.form-label {
  font-size: 28rpx; font-weight: 500; color: #333;
  margin-bottom: 20rpx;
  display: flex; align-items: center;
}
.label-icon {
  margin-right: 10rpx;
}
.required {
  color: #f56c6c;
  margin-left: 6rpx;
}

/* 输入框 */
.form-input, .form-textarea {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.form-input {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-textarea {
  min-height: 200rpx;
}
.input-focus {
  border-color: #409eff !important;
}

/* 多媒体 */
.media-section {
  padding-bottom: 40rpx;
}
.media-btn-group {
  display: flex; gap: 20rpx; margin-bottom: 30rpx;
}
.media-btn {
  flex: 1;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.media-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.media-info {
  text-align: center;
}
.btn-text {
  font-size: 26rpx; color: #666;
}
.count {
  font-size: 22rpx; color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 预览 */
.preview-group {
  margin-top: 30rpx;
}
.group-title {
  font-size: 26rpx; color: #666; margin-bottom: 20rpx; display: block;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.preview-img {
  width: 100%; height: 100%;
}
.del {
  position: absolute;
  top: 10rpx; right: 10rpx;
  width: 36rpx; height: 36rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

/* 音频 */
.audio-item {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.audio-play {
  display: flex; align-items: center; gap: 16rpx;
}
.play-icon {
  font-size: 28rpx;
}
.time {
  font-size: 22rpx; color: #999;
}

/* 选择器 */
.picker-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.picker-text {
  font-size: 28rpx; color: #333;
}
.arrow {
  color: #ccc; font-size: 24rpx;
}
.level-very-important { color: #f56c6c; font-weight: bold; }
.level-important { color: #e6a23c; font-weight: bold; }
.level-normal { color: #67c23a; }

/* 底部 */
.btn-bar {
  display: flex; gap: 20rpx; padding: 20rpx 30rpx 40rpx; background: #fff;
}
.btn {
  flex: 1; height: 88rpx; border-radius: 44rpx; border: none; font-size: 30rpx;
}
.reset {
  background: #f5f7fa; color: #666;
}
.submit {
  background: #409eff; color: #fff;
}
.bottom-space {
  height: 60rpx;
}