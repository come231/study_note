<view class="my-note-container">

<!-- ====================== 【新增】未登录页面 ====================== -->
<view wx:if="{{!isLogin}}" class="not-login-box">
  <view class="login-card">
    <view class="icon-box">🔐</view>
    <text class="title">请先登录</text>
    <text class="desc">登录后即可查看、管理你的个人笔记</text>
    <button class="go-login-btn" bindtap="goToLogin">前往登录</button>
  </view>
</view>

<!-- ====================== 已登录显示你的原有页面 ====================== -->
<view wx:else>
  <!-- 你原来的所有代码 从这里开始 完全复制粘贴 不动 -->
  <view class="search-bar-fixed">
    <view class="my-note-container">
  <!-- 搜索栏 -->
  <view class="search-bar-fixed">
    <view class="search-wrap">
      <input 
        class="search-input" 
        placeholder="输入标题关键词搜索笔记" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="doSearch"
      />
      <view class="search-action-group">
        <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="clearSearch">
          <text class="clear-icon">×</text>
        </view>
        <button class="search-btn" bindtap="doSearch" loading="{{searchLoading}}">
          <text class="search-btn-text">搜索</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <!-- 全部分类行 -->
    <view class="all-category-row">
      <view class="category-item {{activeCategory === '' ? 'active' : ''}}" bindtap="changeCategory">
        <text class="category-text">全部</text>
      </view>
      <!-- 编辑分类按钮 -->
      <button class="edit-category-btn" bindtap="goToEditCategory">✏️ 编辑分类</button>
    </view>

    <!-- 系统分类 -->
    <view class="category-section">
      <text class="section-title">系统分类：</text>
      <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
        <view class="category-scroll-inner">
          <view class="category-item {{activeCategory === item.id ? 'active' : ''}}" 
                bindtap="changeCategory" 
                data-id="{{item.id}}" 
                wx:for="{{systemCategories}}" 
                wx:key="id">
            <text class="category-text">{{item.category_name || '未命名分类'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 自定义分类 -->
    <view class="category-section" wx:if="{{customCategories.length > 0}}">
      <text class="section-title">自定义分类：</text>
      <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
        <view class="category-scroll-inner">
          <view class="category-item {{activeCategory === item.id ? 'active' : ''}}" 
                bindtap="changeCategory" 
                data-id="{{item.id}}" 
                wx:for="{{customCategories}}" 
                wx:key="id">
            <text class="category-text">{{item.category_name || '未命名分类'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 多条件筛选行 -->
    <view class="multi-filter-row">
      <!-- 重要程度筛选 -->
      <view class="filter-item">
        <text class="filter-item-label">重要程度：</text>
        <picker mode="selector" range="{{levelOptions}}" range-key="name" value="{{levelIndex}}" bindchange="changeLevel">
          <view class="picker-text">{{levelOptions[levelIndex].name}}</view>
        </picker>
      </view>

      <!-- 隐私类型筛选 + 选择按钮 -->
      <view class="filter-item">
        <text class="filter-item-label">隐私类型：</text>
        <picker mode="selector" range="{{privacyOptions}}" range-key="name" value="{{privacyIndex}}" bindchange="changePrivacy">
          <view class="picker-text">{{privacyOptions[privacyIndex].name}}</view>
        </picker>
        <!-- 缩小版选择按钮 -->
        <button class="select-mode-btn {{isSelectMode ? 'active' : ''}}" bindtap="toggleSelectMode">
          <text class="select-mode-text">{{isSelectMode ? '取消' : '选择'}}</text>
        </button>
      </view>
    </view>
    
    <!-- 批量操作按钮栏 -->
    <view class="batch-actions-bar" wx:if="{{showBatchActions}}">
      <button class="batch-btn select-all-btn" bindtap="selectAllNotes">
        <text class="batch-btn-text">{{selectedNoteIds.length === noteList.length ? '取消全选' : '全选'}}</text>
      </button>
      <button class="batch-btn delete-btn" bindtap="batchDeleteNotes">
        <text class="batch-btn-text">删除 ({{selectedNoteIds.length}})</text>
      </button>
      <button class="batch-btn move-btn" bindtap="openMoveModal">
        <text class="batch-btn-text">移动</text>
      </button>
    </view>
  </view>

  <!-- 笔记列表滚动容器 -->
  <scroll-view class="note-scroll-container" scroll-y bindscrolltolower="onReachBottom" refresher-enabled="true" bindrefresherrefresh="onPullDownRefresh">
    <!-- 笔记列表区域 -->
    <view class="note-list-container">
      <!-- 加载中 -->
      <view class="loading-container" wx:if="{{loading && noteList.length === 0}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 空数据 -->
      <view class="empty-container" wx:if="{{!loading && noteList.length === 0}}">
        <image class="empty-icon" src="/static/image/icons/empty.png" mode="aspectFit"></image>
        <text class="empty-text">
          {{searchKeyword ? '暂无“' + searchKeyword + '”相关笔记' : '暂无笔记，去创建新笔记吧~'}}
        </text>
      </view>

      <!-- 笔记列表 -->
      <view class="note-list">
        <view class="note-item" 
              wx:for="{{noteList}}" 
              wx:key="id" 
              bindtap="goToDetail" 
              data-note-id="{{item.id}}"
              data-user-id="{{item.user_id}}"
              data-collect-count="{{item.collect_count}}" >
          <!-- 选择框 -->
          <view class="note-select-box" wx:if="{{isSelectMode}}" bindtap="selectNote" data-note-id="{{item.id}}" catchtap>
            <view class="select-checkbox {{selectedNoteIds.includes(item.id) ? 'checked' : ''}}">
              <text class="check-icon" wx:if="{{selectedNoteIds.includes(item.id)}}">✅</text>
            </view>
          </view>
          
          <!-- 笔记内容 -->
          <view class="note-header {{isSelectMode ? 'with-select' : ''}}">
            <text class="note-title">{{item.title || '无标题'}}</text>
            <view class="tag-group">
              <text class="tag category-tag">{{item.category_name || '未分类'}}</text>
              <text class="tag level-tag {{item.level === 1 ? 'level-1' : (item.level === 2 ? 'level-2' : 'level-3')}}">
                {{item.level === 1 ? '非常重要' : (item.level === 2 ? '重要' : '一般')}}
              </text>
              <text class="tag privacy-tag {{item.privacy_type === 1 ? 'private' : 'public'}}">
                {{item.privacy_type === 1 ? '私有' : '公开'}}
              </text>
            </view>
          </view>
          
          <text class="note-content {{isSelectMode ? 'with-select' : ''}}">
            {{item.content ? (item.content.length > 100 ? item.content.substring(0, 100) + '...' : item.content) : '无内容'}}
          </text>
          
          <view class="note-footer {{isSelectMode ? 'with-select' : ''}}">
            <text class="create-time">创建时间：{{item.create_time}}</text>
            <view class="collect-info">
              <image class="collect-icon" src="/static/image/icons/collect.png" mode="aspectFit"></image>
              <text class="collect-count">{{item.collect_count || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{loading && noteList.length > 0 && !isSelectMode}}">
        <view class="small-spinner"></view>
        <text class="load-more-text">加载更多...</text>
      </view>

      <!-- 到底提示 -->
      <view class="no-more" wx:if="{{!loading && !pagination.hasMore && noteList.length > 0 && !isSelectMode}}">
        <text class="no-more-text">已经到底啦~</text>
      </view>
    </view>
  </scroll-view>

  <!-- 移动分类弹窗 -->
  <view class="modal-mask" wx:if="{{showMoveModal}}" bindtap="closeMoveModal"></view>
  <view class="move-modal" wx:if="{{showMoveModal}}">
    <view class="modal-header">
      <text class="modal-title">选择目标分类</text>
      <button class="modal-close-btn" bindtap="closeMoveModal">×</button>
    </view>
    <view class="modal-body">
      <view class="category-list">
        <view class="category-item {{moveTargetCategoryId === item.id ? 'active' : ''}}" 
              wx:for="{{allCategories}}" 
              wx:key="id"
              bindtap="selectMoveCategory"
              data-id="{{item.id}}">
          <text class="category-text">{{item.category_name}}</text>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-cancel-btn" bindtap="closeMoveModal">取消</button>
      <button class="modal-confirm-btn" bindtap="confirmMoveNotes" loading="{{moveLoading}}">
        <text class="confirm-text">确认移动</text>
      </button>
    </view>
  </view>
</view>
  </view>
</view>

</view>

