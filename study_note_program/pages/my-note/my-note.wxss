/* 全局样式 */
page {
  background: linear-gradient(180deg, #f0f4ff 0%, #f7f8fa 100%);
  min-height: 100vh;
}
.my-note-container {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* 搜索栏样式 - 增加内边距，优化间距 */
.search-bar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(102, 126, 234, 0.06);
  z-index: 100;
  box-sizing: border-box;
}
.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f9fafb;
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 80rpx;
}
.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.search-action-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.clear-icon {
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}
.search-btn {
  min-width: 120rpx;
  height: 60rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}
.search-btn::after {
  border: none;
}
.search-btn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 筛选栏 - 调整间距，增加内边距 */
.filter-bar {
  position: fixed;
  top: 120rpx;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 24rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.08);
  z-index: 99;
  box-sizing: border-box;
  border-radius: 0 0 24rpx 24rpx;
  margin-bottom: 20rpx;
}

/* 全部分类行 */
.all-category-row {
  padding: 12rpx 0 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background: #f9fafb;
  border-radius: 24rpx;
  margin-right: 16rpx;
  transition: all 0.3s ease;
  min-width: 120rpx;
  height: 60rpx;
  box-sizing: border-box;
}
.category-scroll-inner {
  display: inline-block;
  padding: 4rpx 0 4rpx 4rpx;
}
.category-scroll-inner .category-item:last-child {
  margin-right: 20rpx;
}
.category-item.active {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 6rpx 18rpx rgba(102, 126, 234, 0.25);
  transform: translateY(-2rpx);
}
.category-text {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
  white-space: nowrap;
}
.category-item.active .category-text {
  color: #fff;
}

/* 编辑分类按钮 */
.edit-category-btn {
  width: 160rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(102, 126, 234, 0.25);
  border: none;
  transition: all 0.2s ease;
}
.edit-category-btn::after {
  border: none;
}
.edit-category-btn:active {
  transform: scale(0.95);
}

/* 分类分区 */
.category-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 8rpx 0;
}
.section-title {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 600;
  min-width: 120rpx;
  margin-right: 16rpx;
}
.category-scroll {
  flex: 1;
  white-space: nowrap;
  padding-bottom: 4rpx;
  box-sizing: border-box;
  overflow: visible;
}

/* 多条件筛选行 */
.multi-filter-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
}
.filter-item-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.picker-text {
  font-size: 24rpx;
  color: #374151;
  padding: 12rpx 20rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  flex: 1;
  text-align: center;
  border: 1rpx solid #e5e7eb;
  transition: all 0.2s ease;
  white-space: nowrap;
  flex-shrink: 0;
}
.picker-text:active {
  background: #f3f4f6;
}

/* 缩小版选择按钮 */
page .select-mode-btn {
  width: 140rpx;
  height: 50rpx;
  margin-left: 15rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 1rpx solid #667eea;
  color: #667eea;
  font-size: 22rpx;
}
.select-mode-btn::after {
  border: none;
}
.select-mode-btn.active {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.select-mode-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 批量操作按钮栏 */
.batch-actions-bar {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 0 10rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}
.batch-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.batch-btn::after {
  border: none;
}
.select-all-btn {
  background: #f9fafb;
  color: #667eea;
}
.delete-btn {
  background: linear-gradient(90deg, #fca5a5 0%, #ef4444 100%);
  color: #fff;
}
.move-btn {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.batch-btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 笔记选择框 */
.note-select-box {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 48rpx;
  height: 48rpx;
  z-index: 10;
}
.select-checkbox {
  width: 100%;
  height: 100%;
  border: 2rpx solid #667eea;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  transition: all 0.2s ease;
}
.select-checkbox.checked {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-color: #667eea;
}
.check-icon {
  font-size: 32rpx;
  color: #fff;
}

/* 笔记内容偏移 */
.note-header.with-select,
.note-content.with-select,
.note-footer.with-select {
  padding-left: 80rpx;
}

/* 笔记列表滚动容器 - 增加顶部内边距，优化间距 */
.note-scroll-container {
  width: 100%;
  height: 100vh;
  padding-top: 620rpx;
  box-sizing: border-box;
}

/* 笔记列表容器 */
.note-list-container {
  padding: 0 24rpx 40rpx;
}

/* 加载中样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e7ff;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #667eea;
}

/* 空数据样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}
.empty-text {
  font-size: 28rpx;
  color: #667eea;
}

/* 笔记列表 - 增加间距，优化卡片样式 */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}
.note-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  margin-bottom: 10rpx;
}
.note-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.note-item:hover::before,
.note-item:active::before {
  opacity: 1;
}
.note-item:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.05);
}

/* 笔记标题栏 */
.note-header {
  margin-bottom: 20rpx;
}
.note-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
}
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  min-width: 100rpx;
  text-align: center;
}
.category-tag {
  background: #eff6ff;
  color: #3b82f6;
}
.level-tag {
  color: #fff;
}
.level-1 {
  background: linear-gradient(90deg, #fca5a5 0%, #f87171 100%);
  color: #dc2626;
}
.level-2 {
  background: linear-gradient(90deg, #f87171 0%, #ef4444 100%);
  color: #b91c1c;
}
.level-3 {
  background: linear-gradient(90deg, #e5e7eb 0%, #d1d5db 100%);
  color: #6b7280;
}
.privacy-tag {
  color: #fff;
}
.private {
  background: linear-gradient(90deg, #fdba74 0%, #f97316 100%);
  color: #c2410c;
}
.public {
  background: linear-gradient(90deg, #a7f3d0 0%, #10b981 100%);
  color: #065f46;
}

/* 笔记内容 */
.note-content {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 笔记底部信息 */
.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}
.create-time {
  font-size: 24rpx;
  color: #9ca3af;
}
.collect-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.collect-icon {
  width: 28rpx;
  height: 28rpx;
}
.collect-count {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

/* 加载更多/到底提示 */
.load-more, .no-more {
  text-align: center;
  padding: 24rpx 0;
}
.load-more-text, .no-more-text {
  font-size: 24rpx;
  color: #667eea;
}
.small-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #e0e7ff;
  border-top: 3rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  display: inline-block;
  margin-right: 10rpx;
  vertical-align: middle;
}

/* 移动分类弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}
.move-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  overflow: hidden;
}
.modal-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close-btn {
  width: 48rpx;
  height: 48rpx;
  border: none;
  background: transparent;
  font-size: 32rpx;
  color: #9ca3af;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-close-btn::after {
  border: none;
}
.modal-body {
  max-height: 600rpx;
  overflow-y: auto;
  padding: 24rpx;
}
.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.move-modal .category-item {
  width: 100%;
  margin-right: 0;
}
.modal-footer {
  padding: 16rpx 24rpx 24rpx;
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}
.modal-cancel-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  color: #6b7280;
  border: none;
}
.modal-cancel-btn::after {
  border: none;
}
.modal-confirm-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}
.modal-confirm-btn::after {
  border: none;
}
.confirm-text {
  font-size: 28rpx;
  font-weight: 500;
}
/* ====================== 【新增】未登录美化样式 ====================== */
.not-login-box {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f0f4ff 0%, #f7f8fa 100%);
}
.login-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.15);
  text-align: center;
}
.icon-box {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.login-card .title {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}
.login-card .desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
  display: block;
  line-height: 1.6;
}
.go-login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.2);
}
.go-login-btn::after {
  border: none;
}

