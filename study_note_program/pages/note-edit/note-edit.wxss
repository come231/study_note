page {
  background-color: #f0f2f5;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.note-edit-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 导航栏样式 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
  color: #fff;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.nav-left {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.nav-hover {
  background-color: rgba(255, 255, 255, 0.15);
}

.nav-left .icon {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-right {
  width: 60rpx;
}

/* 表单滚动区域（核心：增加底部内边距，确保多媒体区不被遮挡） */
.form-scroll {
  flex: 1;
  padding: 20rpx 30rpx 150rpx; /* 底部内边距大于按钮栏高度，确保滑动到底能显示完整 */
  box-sizing: border-box;
}

/* 底部空白区（进一步确保滑动完整） */
.scroll-bottom-space {
  height: 20rpx;
}

/* 表单项通用样式 */
.form-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.form-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  border-radius: 24rpx 0 0 24rpx;
}

.title-item::before {
  background: linear-gradient(180deg, #ff9f1c 0%, #e76f51 100%);
}

.content-item::before {
  background: linear-gradient(180deg, #2a9d8f 0%, #264653 100%);
}

.selector-item::before {
  background: linear-gradient(180deg, #8338ec 0%, #581845 100%);
}

.form-item:hover {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-2rpx);
}

.form-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #2d3748;
  margin-bottom: 20rpx;
  font-weight: 600;
}

/* 多媒体区标签样式 */
.media-label {
  margin-bottom: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #cbd5e1;
}

.label-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.required {
  color: #ef4444;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.placeholder-style {
  color: #94a3b8;
  font-size: 26rpx;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  font-size: 28rpx;
  color: #1e293b;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e2e8f0;
  transition: all 0.3s ease;
}

.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1e293b;
  min-height: 300rpx;
  line-height: 1.8;
  padding: 16rpx 0;
  transition: all 0.3s ease;
  border-bottom: 2rpx solid #e2e8f0;
  margin-bottom: 10rpx; /* 内容框与多媒体区间距 */
}

.input-focus {
  border-bottom-color: #4361ee;
  box-shadow: 0 2rpx 0 0 #4361ee;
}

/* 多媒体操作区（内容框内下方） */
.media-operate-area {
  width: 100%;
  margin-top: 10rpx;
}

.media-btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.media-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.3s ease;
  position: relative;
}

.image-btn {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 2rpx solid #dee2e6;
}

.voice-btn {
  background: linear-gradient(135deg, #fdf2f8 0%, #fef7fb 100%);
  border: 2rpx solid #f0e6ed;
}

.media-btn::after {
  border: none;
}

.media-btn-hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.media-icon {
  font-size: 30rpx;
}

.media-text {
  font-size: 26rpx;
  color: #2d3748;
  font-weight: 600;
}

.media-count {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 多媒体预览区 */
.media-preview-area {
  margin-top: 20rpx;
}

.preview-title {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 16rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.preview-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #4361ee;
  border-radius: 4rpx;
}

/* 图片预览 */
.image-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.image-item-hover {
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

.preview-img {
  width: 100%;
  height: 100%;
}

/* 音频预览（替换原语音） */
.audio-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.audio-item {
  height: 90rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.audio-item-hover {
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 80%;
}

.audio-icon {
  font-size: 32rpx;
  color: #4361ee;
}

.audio-text {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 500;
}

.audio-duration {
  font-size: 22rpx;
  color: #64748b;
  background: #e2e8f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: auto;
}

/* 删除按钮 */
.delete-img, .delete-audio {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(239, 68, 68, 0.4);
  transition: all 0.3s ease;
  z-index: 10;
}

.delete-hover {
  background: #dc2626;
  transform: scale(1.15);
  box-shadow: 0 6rpx 12rpx rgba(239, 68, 68, 0.5);
}

.delete-audio {
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
}

/* 选择器样式（默认回显笔记内容） */
.picker-container {
  width: 100%;
}

.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e2e8f0;
  transition: all 0.3s ease;
}

.picker-hover {
  border-bottom-color: #94a3b8;
}

.picker-text {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.picker-icon {
  font-size: 24rpx;
  color: #64748b;
  transition: transform 0.3s ease;
}

.picker-wrap:hover .picker-icon {
  transform: rotate(180deg);
  color: #4361ee;
}

/* 重要程度文字颜色 */
.level-normal {
  color: #4361ee;
  font-weight: 600;
}

.level-important {
  color: #f59e0b;
  font-weight: 600;
}

.level-very-important {
  color: #ef4444;
  font-weight: 600;
}

/* 底部固定按钮栏 */
.fixed-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 99;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 30rpx 30rpx;
}

.btn-bar {
  display: flex;
  gap: 20rpx;
}

.reset-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: #475569;
  border-radius: 45rpx;
  font-size: 30rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.reset-btn-hover {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  color: #2d3748;
  border-color: #cbd5e1;
}

.save-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
  color: #fff;
  border-radius: 45rpx;
  font-size: 30rpx;
  border: none;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.save-btn-hover {
  opacity: 0.95;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(67, 97, 238, 0.4);
}

.save-btn::after, .reset-btn::after {
  border: none;
}

.save-btn[disabled], .reset-btn[disabled] {
  opacity: 0.6;
  transform: none;
  box-shadow: none;
  cursor: not-allowed;
}

.btn-icon {
  font-size: 28rpx;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #94a3b8;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
}

/* 适配小屏设备 */
@media (max-width: 320px) {
  .form-item {
    padding: 24rpx;
  }
  .nav-title {
    font-size: 30rpx;
  }
  .save-btn, .reset-btn {
    font-size: 28rpx;
    height: 80rpx;
    line-height: 80rpx;
  }
  .form-scroll {
    padding: 15rpx 20rpx 140rpx;
  }
  /* 上次更新时间 */
.update-time {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #64748b;
}
.time-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}
.time-text {
  color: #64748b;
}
  
}