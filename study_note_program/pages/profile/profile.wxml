<view class="profile-container">
  <!-- 顶部用户信息区 -->
  <view class="user-info-section">
    <view class="avatar-wrapper" bindtap="goToLogin">
      <image 
        class="user-avatar" 
        src="{{isLogin ? userInfo.userAvatar: defaultAvatarUrl}}" 
        mode="aspectFill">
      </image>
      <view class="login-tips" wx:if="{{!isLogin}}">点击登录</view>
    </view>
    
    <view class="user-info" wx:if="{{isLogin}}">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="username">@{{userInfo.userName}}</text>
    </view>
    
    <view class="unlogin-text" wx:else>
      <text>未登录</text>
    </view>
  </view>

  <!-- 功能入口列表 -->
  <view class="function-list">
    <view class="function-item" bindtap="goToMyInfo">
      <view class="item-icon">
        <text class="icon-text">👤</text>
      </view>
      <view class="item-content">
        <text class="item-title">账号信息</text>
        <text class="item-desc">管理个人账号资料</text>
      </view>
      <view class="item-arrow">＞</view>
    </view>

    <view class="function-item" bindtap="goToMyNote">
      <view class="item-icon">
        <text class="icon-text">📝</text>
      </view>
      <view class="item-content">
        <text class="item-title">个人笔记</text>
        <text class="item-desc">查看我的所有笔记</text>
      </view>
      <view class="item-arrow">＞</view>
    </view>

    <view class="function-item" bindtap="goToCollectList">
      <view class="item-icon">
        <text class="icon-text">⭐</text>
      </view>
      <view class="item-content">
        <text class="item-title">我的收藏</text>
        <text class="item-desc">查看收藏的笔记</text>
      </view>
      <view class="item-arrow">＞</view>
    </view>

    <view class="function-item" bindtap="goToCategory">
      <view class="item-icon">
        <text class="icon-text">📁</text>
      </view>
      <view class="item-content">
        <text class="item-title">分类管理</text>
        <text class="item-desc">管理笔记分类</text>
      </view>
      <view class="item-arrow">＞</view>
    </view>
  </view>

  <!-- 退出登录按钮（登录后显示） -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>