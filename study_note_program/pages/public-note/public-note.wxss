/* 全局样式 */
page {
  background-color: #f8f9fa;
  min-height: 100vh;
}
.page-container {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===================== 顶部搜索栏 ===================== */
.search-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: #fff;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
/* 搜索类型切换 */
.search-type {
  display: flex;
  background: #f5f7fa;
  border-radius: 24rpx;
  overflow: hidden;
}
.type-item {
  padding: 8rpx 20rpx;
  background: #f5f7fa;
}
.type-item.active {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}
.type-text {
  font-size: 24rpx;
  color: #666;
}
.type-item.active .type-text {
  color: #fff;
  font-weight: 500;
}
/* 搜索输入框 */
.search-input-wrap {
  flex: 1;
  position: relative;
  background: #f5f7fa;
  border-radius: 24rpx;
  padding: 0 20rpx;
}
.search-input {
  width: 100%;
  height: 64rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}
.clear-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.clear-icon {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}
/* 搜索按钮 */
.search-btn {
  min-width: 120rpx;
  height: 64rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}
.search-btn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* ===================== 固定顶部分类栏 ===================== */
.category-fixed {
  position: fixed;
  top: 88rpx; /* 空出搜索栏高度 */
  left: 0;
  width: 100%;
  z-index: 999;
  background: #fff;
}
.category-bar {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}
.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}
.category-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: #f5f7fa;
  transition: all 0.2s ease;
}
.category-item.active {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}
.category-text {
  font-size: 26rpx;
  color: #666;
}
.category-item.active .category-text {
  color: #fff;
  font-weight: 500;
}

/* ===================== 笔记列表 ===================== */
.note-list {
  flex: 1;
  margin-top: 152rpx; /* 搜索栏+分类栏高度 */
  padding-bottom: 20rpx;
}
.loading-container {
  padding: 100rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}
.empty-container {
  padding: 120rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 笔记项样式升级 */
.note-item {
  background: #fff;
  margin: 16rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}
.note-item:active {
  transform: scale(0.98);
}
.category-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.note-content {
  margin-bottom: 24rpx;
}
.note-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.note-preview {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 笔记底部 */
.note-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f7fa;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.author-info {
  display: flex;
  align-items: center;
  flex: 1;
}
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #f0f0f0;
}
.author-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}
.time-info {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}
.time-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 4rpx;
}
.time-text {
  font-size: 24rpx;
  color: #666;
}
.collect-container {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}
.collect-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 4rpx;
}
.collect-count {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

/* 加载更多 */
.load-more {
  padding: 30rpx 0;
  text-align: center;
}
.load-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 到底提示 */
.no-more-tip {
  padding: 20rpx 0 40rpx;
  text-align: center;
}
.no-more-text {
  font-size: 26rpx;
  color: #999;
}